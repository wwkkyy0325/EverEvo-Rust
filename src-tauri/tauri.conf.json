{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri-docs/refs/heads/dev/.schemas/config.schema.json",
  "productName": "EverEvo",
  "version": "0.1.0",
  "identifier": "com.everevo.app",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd frontend && npm run dev",
    "beforeBuildCommand": "cd frontend && npm run build"
  },
  "bundle": {
    "resources": {
      "../resources/bundled/**/*": "bundled/"
    }
  },
  "app": {
    "windows": [
      {
        "title": "EverEvo AI Agent",
        "width": 1100,
        "height": 750,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "center": true,
        "windowEffects": {
          "effects": ["mica"]
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:*; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
